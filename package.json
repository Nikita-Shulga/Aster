{
  "name": "aster",
  "productName": "Aster",
  "version": "2.0.0",
  "description": "Aster — a fast, honest cleaner, optimizer and uninstaller for Windows and macOS.",
  "author": "Nikita Shulga",
  "license": "MIT",
  "homepage": "https://github.com/Nikita-Shulga/Aster",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview-server.cjs",
    "test": "node --test test/*.test.cjs",
    "icons": "electron scripts/build-icons.cjs",
    "screenshots": "electron scripts/screenshots.cjs",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nikitashulga.aster",
    "productName": "Aster",
    "copyright": "Copyright © 2026 Nikita Shulga",
    "asar": true,
    "directories": {"output": "dist", "buildResources": "assets"},
    "files": ["src/**/*", "assets/icon.png", "package.json", "LICENSE"],
    "artifactName": "Aster-${version}-${arch}.${ext}",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "Aster-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aster",
      "deleteAppDataOnUninstall": false
    },
    "portable": {"artifactName": "Aster-${version}-portable.exe"},
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "Aster-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Aster uses System Events to list and manage your login items and to switch light/dark mode.",
        "NSDesktopFolderUsageDescription": "Aster analyzes folders you choose to show what takes up space.",
        "NSDocumentsFolderUsageDescription": "Aster analyzes folders you choose to show what takes up space.",
        "NSDownloadsFolderUsageDescription": "Aster can clean old installers from your Downloads folder."
      }
    },
    "dmg": {"title": "Aster ${version}", "artifactName": "Aster-${version}-mac-${arch}.${ext}"}
  }
}
